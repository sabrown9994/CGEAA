{
  "name": "zdf",
  "version": "1.0.0",
  "description": "Zuora Development Framework CLI",
  "type": "commonjs",
  "bin": { "zdf": "./dist/zdf.js" },
  "main": "./dist/zdf.js",
  "scripts": {
    "build": "tsup bin/zdf.ts --format cjs --out-dir dist",
    "dev": "tsx bin/zdf.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": { "node": ">=18.0.0" },
  "files": ["dist"],
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "inquirer": "^8.2.0",
    "ora": "^5.4.0"
  },
  "devDependencies": {
    "@types/inquirer": "^8.0.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
