#!/bin/bash

# CGEAA Setup Script
# Initializes CGEAA configuration and sets up the environment

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CGEAA_LIB_DIR="${SCRIPT_DIR}/cgeaa-lib"

# Source utility functions
source "${CGEAA_LIB_DIR}/utils.sh"
source "${CGEAA_LIB_DIR}/config.sh"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}"
cat << 'EOF'
   ______ _____ ______ ___
  / ____// ____// ____//   |   /\
 / /    / / __ / __/  / /| |  /  \
/ /___ / /_/ // /___ / ___ | / /\ \
\____/ \____//_____//_/  |_|/_/  \_\

CarGurus Enterprise Applications Automation
Setup & Configuration
EOF
echo -e "${NC}"

# Minimum Node.js major version required to build and run zdf.
ZDF_MIN_NODE_MAJOR=18

# Print the installed Node.js major version, or nothing if node is absent /
# unparseable. Used to gate the >=18 requirement.
_node_major_version() {
    command_exists node || return 0
    local raw
    raw="$(node --version 2>/dev/null)" || return 0
    # Strip a leading 'v' and take the first dot-delimited component.
    raw="${raw#v}"
    echo "${raw%%.*}"
}

# Attempt to install Node.js >=18 using whichever package manager is available.
# Returns 0 on success (node and npm are both on PATH afterwards), 1 otherwise.
# Prompts before running anything that requires sudo or a network install.
_install_node() {
    local os
    os="$(uname -s)"

    log_info "Attempting to install Node.js >=${ZDF_MIN_NODE_MAJOR}..."

    if [ "$os" = "Darwin" ]; then
        if command_exists brew; then
            read -p "Install Node.js via 'brew install node@${ZDF_MIN_NODE_MAJOR}'? (y/n) " -n 1 -r
            echo
            [[ ! $REPLY =~ ^[Yy]$ ]] && return 1
            if brew install "node@${ZDF_MIN_NODE_MAJOR}" && brew link --overwrite --force "node@${ZDF_MIN_NODE_MAJOR}"; then
                return 0
            fi
            return 1
        fi
        log_warning "Homebrew not found. Install brew from https://brew.sh, or install Node.js >=${ZDF_MIN_NODE_MAJOR} manually, then re-run this script."
        return 1
    fi

    if [ "$os" = "Linux" ]; then
        if command_exists apt-get; then
            read -p "Install Node.js via apt-get (uses NodeSource ${ZDF_MIN_NODE_MAJOR}.x repo, requires sudo)? (y/n) " -n 1 -r
            echo
            [[ ! $REPLY =~ ^[Yy]$ ]] && return 1
            if curl -fsSL "https://deb.nodesource.com/setup_${ZDF_MIN_NODE_MAJOR}.x" | sudo -E bash - && sudo apt-get install -y nodejs; then
                return 0
            fi
            return 1
        fi
        if command_exists dnf; then
            read -p "Install Node.js via dnf (requires sudo)? (y/n) " -n 1 -r
            echo
            [[ ! $REPLY =~ ^[Yy]$ ]] && return 1
            if sudo dnf install -y "nodejs" "npm"; then
                return 0
            fi
            return 1
        fi
        if command_exists yum; then
            read -p "Install Node.js via yum (requires sudo)? (y/n) " -n 1 -r
            echo
            [[ ! $REPLY =~ ^[Yy]$ ]] && return 1
            if sudo yum install -y "nodejs" "npm"; then
                return 0
            fi
            return 1
        fi
        log_warning "No supported package manager found (apt-get, dnf, yum). Install Node.js >=${ZDF_MIN_NODE_MAJOR} manually, then re-run this script."
        return 1
    fi

    log_warning "Unsupported platform: $os. Install Node.js >=${ZDF_MIN_NODE_MAJOR} manually, then re-run this script."
    return 1
}

# Ensure node and npm are on PATH at the required version, offering to install
# them if not. Returns 0 if the environment is ready, 1 if the caller should
# skip the ZDF install.
_ensure_node_toolchain() {
    local major
    major="$(_node_major_version)"

    if command_exists node && command_exists npm && [ -n "$major" ] && [ "$major" -ge "$ZDF_MIN_NODE_MAJOR" ]; then
        log_info "Detected Node.js $(node --version) — meets zdf requirement (>=${ZDF_MIN_NODE_MAJOR})."
        return 0
    fi

    if command_exists node && [ -n "$major" ] && [ "$major" -lt "$ZDF_MIN_NODE_MAJOR" ]; then
        log_warning "Node.js $(node --version) is installed but zdf requires >=${ZDF_MIN_NODE_MAJOR}."
    else
        log_warning "Node.js not found on PATH — required by 'cgeaa zuora' (ZDF)."
    fi

    if ! _install_node; then
        log_warning "Skipping ZDF install. 'cgeaa zuora' will be unavailable until Node.js >=${ZDF_MIN_NODE_MAJOR} is installed."
        return 1
    fi

    # Re-check post-install.
    major="$(_node_major_version)"
    if ! command_exists node || ! command_exists npm || [ -z "$major" ] || [ "$major" -lt "$ZDF_MIN_NODE_MAJOR" ]; then
        log_warning "Node.js install did not yield a usable node/npm on PATH. You may need to open a new shell and re-run ./cgeaa-setup."
        return 1
    fi

    log_success "Node.js $(node --version) is now available."
    return 0
}

# Public npm registry — used as a fallback when the configured registry
# (e.g. an internal Artifactory) is unreachable.
ZDF_PUBLIC_NPM_REGISTRY="https://registry.npmjs.org/"

# Probe the currently-configured npm registry to see if it responds within
# ~5s. Prints nothing on success; returns non-zero if the registry appears
# unreachable so the caller can fall back.
_npm_registry_reachable() {
    local registry
    registry="$(npm config get registry 2>/dev/null)"
    [ -z "$registry" ] && return 1
    curl --max-time 5 -sI "$registry" -o /dev/null 2>&1
    local status=$?
    if [ $status -ne 0 ]; then
        return 1
    fi
    return 0
}

# Run 'npm install' inside a zdf checkout with progress visible and a fetch
# timeout so hangs surface as errors. Falls back to the public npm registry
# on the second attempt when the configured (e.g. internal) registry is
# unreachable or an install fails outright.
_npm_install_zdf() {
    local zdf_src="$1"
    local install_verb="$2"  # 'install' or 'ci'
    local configured_registry
    configured_registry="$(npm config get registry 2>/dev/null)"

    # Common flags: cap fetch retries and timeouts so we do not spin forever.
    local -a common_flags=(
        --fetch-retries=2
        --fetch-timeout=60000
        --fetch-retry-mintimeout=5000
        --fetch-retry-maxtimeout=15000
    )

    log_info "Using npm registry: ${configured_registry:-<default>}"

    if _npm_registry_reachable; then
        log_info "Running: npm ${install_verb} (in $zdf_src)"
        if (cd "$zdf_src" && npm "$install_verb" "${common_flags[@]}"); then
            return 0
        fi
        log_warning "npm ${install_verb} against ${configured_registry} failed."
    else
        log_warning "Configured npm registry (${configured_registry:-<none>}) is not reachable within 5s."
        log_warning "This is usually a VPN / network issue with an internal registry."
    fi

    # Fallback: try the public registry unless that IS the configured one.
    if [ "$configured_registry" = "$ZDF_PUBLIC_NPM_REGISTRY" ]; then
        return 1
    fi

    read -p "Retry using the public npm registry (${ZDF_PUBLIC_NPM_REGISTRY})? (y/n) " -n 1 -r
    echo
    [[ ! $REPLY =~ ^[Yy]$ ]] && return 1

    log_info "Retrying with public registry: ${ZDF_PUBLIC_NPM_REGISTRY}"
    (cd "$zdf_src" && npm "$install_verb" --registry="$ZDF_PUBLIC_NPM_REGISTRY" "${common_flags[@]}")
}

# --- ZDF Installation Function ---
# Builds zdf from the checkout and copies the ready-to-run tree (source + dist +
# node_modules) into /usr/local/share/cgeaa/zdf. Kept as a soft dependency: if
# node/npm cannot be provisioned or the build fails, we warn and continue so
# Salesforce functionality still installs cleanly.
install_zdf_globally() {
    local zdf_src="${SCRIPT_DIR}/zdf"

    if [ ! -d "$zdf_src" ]; then
        log_warning "zdf source not found at $zdf_src — skipping Zuora (ZDF) install."
        return 0
    fi

    if ! _ensure_node_toolchain; then
        return 0
    fi

    log_info "Installing ZDF dependencies (in ${zdf_src})..."
    local npm_install_cmd="install"
    if [ -f "${zdf_src}/package-lock.json" ]; then
        npm_install_cmd="ci"
    fi
    if ! _npm_install_zdf "$zdf_src" "$npm_install_cmd"; then
        log_warning "ZDF dependency install failed — skipping global install of zdf."
        log_warning "You can retry later by re-running ./cgeaa-setup (verify VPN or npm registry access first)."
        return 0
    fi

    log_info "Building ZDF..."
    if ! (cd "$zdf_src" && npm run build); then
        log_warning "ZDF build failed — skipping global install of zdf."
        log_warning "You can retry later by re-running ./cgeaa-setup."
        return 0
    fi

    log_info "Copying zdf/ to /usr/local/share/cgeaa/..."
    # Remove any prior copy first so stale files (e.g. old dist/) do not linger.
    sudo rm -rf /usr/local/share/cgeaa/zdf
    sudo cp -r "$zdf_src" /usr/local/share/cgeaa/

    log_success "ZDF installed globally."
}

# --- Installation Function ---
perform_global_install() {
    log_step "Performing Global Installation"

    # 1. Create global library directory
    log_info "Creating library directory at /usr/local/share/cgeaa..."
    sudo mkdir -p /usr/local/share/cgeaa

    # 2. Copy library files
    log_info "Copying cgeaa-lib contents..."
    sudo cp -r "${SCRIPT_DIR}/cgeaa-lib" /usr/local/share/cgeaa/

    # 2b. Build and copy the Zuora Development Framework (soft dependency)
    install_zdf_globally

    # 3. Create a temporary modified cgeaa script
    log_info "Configuring cgeaa script for global use..."
    TEMP_CGEAA_SCRIPT=$(mktemp)
    # Rewrite lines 10 and 11 to point at the global install location. SCRIPT_DIR
    # must remain defined — zuora.sh derives ZDF_SOURCE_DIR from it.
    sed -e '10s|.*|SCRIPT_DIR="/usr/local/share/cgeaa"|' \
        -e '11s|.*|CGEAA_LIB_DIR="/usr/local/share/cgeaa/cgeaa-lib"|' \
        "${SCRIPT_DIR}/cgeaa" > "$TEMP_CGEAA_SCRIPT"

    # 4. Copy the modified script to /usr/local/bin
    log_info "Copying cgeaa to /usr/local/bin..."
    sudo cp "$TEMP_CGEAA_SCRIPT" /usr/local/bin/cgeaa
    rm "$TEMP_CGEAA_SCRIPT"

    # 5. Make it executable
    log_info "Setting execution permissions..."
    sudo chmod 755 /usr/local/bin/cgeaa

    # 6. Save source repo path for updates
    log_info "Saving source repository path for future updates..."
    add_or_update_config "source_repo_path" "$SCRIPT_DIR" "$GLOBAL_CONFIG_FILE"

    log_success "Global installation complete!"
}

install_globally() {
    echo
    echo -e "${YELLOW}--- Global Installation ---${NC}"
    read -p "Do you want to install 'cgeaa' globally to /usr/local/bin? (y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Skipping global installation."
        echo
        echo -e "${YELLOW}Optional: Add CGEAA to your PATH${NC}"
        echo "To use 'cgeaa' from anywhere, add this line to your ~/.bashrc or ~/.zshrc:"
        echo "export PATH=\"$SCRIPT_DIR:\$PATH\""
        return
    fi

    perform_global_install
    echo "You can now run 'cgeaa' from any directory. Open a new terminal to start."
}


# --- Main Setup Logic ---

# Check if we're in the right directory
if [ ! -f "cgeaa" ]; then
    echo -e "${RED}Error: cgeaa script not found in current directory${NC}"
    echo "Please run this setup script from the directory containing the cgeaa script"
    exit 1
fi

echo "Setting up CGEAA environment..."
echo

# Make sure core scripts are executable
chmod +x cgeaa
chmod +x cgeaa-uninstall
echo "✓ Made core scripts executable"

# Create global config directory
GLOBAL_CONFIG_DIR="$HOME/.cgeaa"
if [ ! -d "$GLOBAL_CONFIG_DIR" ]; then
    mkdir -p "$GLOBAL_CONFIG_DIR"
    echo "✓ Created global config directory: $GLOBAL_CONFIG_DIR"
fi

# Create global config file if it doesn't exist
GLOBAL_CONFIG_FILE="$GLOBAL_CONFIG_DIR/config"
if [ ! -f "$GLOBAL_CONFIG_FILE" ]; then
    create_sample_config "$GLOBAL_CONFIG_FILE"
    echo "✓ Created global configuration file"
else
    echo "✓ Global configuration file already exists"
fi

# Create project config directory
PROJECT_CONFIG_DIR=".cgeaa"
if [ ! -d "$PROJECT_CONFIG_DIR" ]; then
    mkdir -p "$PROJECT_CONFIG_DIR"
    echo "✓ Created project config directory: $PROJECT_CONFIG_DIR"
fi

# Create project config file if it doesn't exist
PROJECT_CONFIG_FILE="$PROJECT_CONFIG_DIR/config"
if [ ! -f "$PROJECT_CONFIG_FILE" ]; then
    create_sample_config "$PROJECT_CONFIG_FILE"
    echo "✓ Created project configuration file"
else
    echo "✓ Project configuration file already exists"
fi

# --- Run Installation ---
install_globally

# --- Configure Coverage Mappings Repository ---
echo
echo -e "${YELLOW}--- Coverage Mappings Repository ---${NC}"
echo "CGEAA reads Apex class → test class mappings from a sibling git repository."
echo "Expected layout:"
echo "  <parent>/"
echo "  ├── CGEAA/                       ← this repo"
echo "  └── EA-Salesforce-Mappings/      ← mappings repo"
echo "      └── JSON/test-coverage-map.json"
echo
read -p "Enter the mappings repository name (press Enter to use default: EA-Salesforce-Mappings): " MAPPINGS_REPO
MAPPINGS_REPO="${MAPPINGS_REPO:-EA-Salesforce-Mappings}"

read -p "Enter the git clone URL for ${MAPPINGS_REPO} (press Enter to use default: https://github.com/cargurus-ea/EA-Salesforce-Mappings): " MAPPINGS_REPO_URL
MAPPINGS_REPO_URL="${MAPPINGS_REPO_URL:-https://github.com/cargurus-ea/EA-Salesforce-Mappings}"

MAPPINGS_REPO_PATH="$(dirname "$SCRIPT_DIR")/${MAPPINGS_REPO}"
MAP_FILE="${MAPPINGS_REPO_PATH}/JSON/test-coverage-map.json"

if [ -d "$MAPPINGS_REPO_PATH" ]; then
    if [ -f "$MAP_FILE" ]; then
        echo "✓ Mappings repository found and test-coverage-map.json is present"
    else
        echo -e "${YELLOW}⚠ Repository directory found at $MAPPINGS_REPO_PATH but JSON/test-coverage-map.json is missing${NC}"
        echo "  CGEAA will fall back to live ApexCodeCoverage queries until the file is present."
    fi
else
    if [ -n "$MAPPINGS_REPO_URL" ]; then
        echo "Repository not found locally — attempting to clone..."
        if git clone "$MAPPINGS_REPO_URL" "$MAPPINGS_REPO_PATH" --quiet 2>/dev/null; then
            echo "✓ Cloned ${MAPPINGS_REPO} successfully"
        else
            echo -e "${YELLOW}⚠ Clone failed. CGEAA will attempt to clone automatically on first use.${NC}"
        fi
    else
        echo -e "${YELLOW}⚠ Repository not found at $MAPPINGS_REPO_PATH and no URL provided${NC}"
        echo "  CGEAA will fall back to live ApexCodeCoverage queries until the repo is available."
        echo "  You can set coverage_mappings_repo_url in your config to enable auto-cloning."
    fi
fi

add_or_update_config "coverage_mappings_repo" "$MAPPINGS_REPO" "$GLOBAL_CONFIG_FILE"
add_or_update_config "coverage_mappings_repo" "$MAPPINGS_REPO" "$PROJECT_CONFIG_FILE"
if [ -n "$MAPPINGS_REPO_URL" ]; then
    add_or_update_config "coverage_mappings_repo_url" "$MAPPINGS_REPO_URL" "$GLOBAL_CONFIG_FILE"
    add_or_update_config "coverage_mappings_repo_url" "$MAPPINGS_REPO_URL" "$PROJECT_CONFIG_FILE"
fi
echo "✓ Coverage mappings repo configured: $MAPPINGS_REPO"

# Check dependencies
echo
echo "Checking dependencies..."
check_dependencies
echo "✓ All dependencies are available"

# Final advisory: only fires if the interactive Node.js install was declined or
# unavailable during global install. Salesforce commands work regardless.
if ! command_exists node || ! command_exists npm; then
    echo -e "${YELLOW}⚠ node/npm still not on PATH.${NC}"
    echo "  These are required for 'cgeaa zuora' (ZDF) commands only."
    echo "  Install Node.js >=${ZDF_MIN_NODE_MAJOR:-18} and re-run ./cgeaa-setup to enable Zuora support."
fi

# Test basic functionality
echo
echo "Testing CGEAA..."
if cgeaa version > /dev/null 2>&1; then
    echo "✓ CGEAA is working correctly"
else
    echo -e "${RED}✗ CGEAA test failed. If you chose global install, try opening a new terminal.${NC}"
fi

echo
echo -e "${GREEN}CGEAA setup completed successfully!${NC}"
echo
echo "Next steps:"
echo "1. Clone the coverage mappings repository as a sibling of this directory (if not already done):"
echo "   cd .. && git clone <EA-Salesforce-Mappings-url>"
echo
echo "2. Review and customize the configuration files:"
echo "   - Global: $GLOBAL_CONFIG_FILE"
echo "   - Project: $PROJECT_CONFIG_FILE"
echo
echo "3. Authenticate to your Salesforce orgs:"
echo "   sf auth web login --alias targetOrg"
echo
echo "4. Try running CGEAA:"
echo "   cgeaa validate --dry-run"
echo
echo "For help, run: cgeaa help"

# --- Configure Zuora (ZDF) authentication ---
if command_exists node && [ -f "/usr/local/share/cgeaa/zdf/dist/zdf.js" ]; then
    echo
    echo -e "${YELLOW}--- Zuora (ZDF) Authentication ---${NC}"
    echo "To use 'cgeaa zuora' commands you need to authenticate with a Zuora environment."
    echo "You will need: the Zuora REST API base URL, an OAuth client ID, and a client secret."
    echo "(These come from your Zuora tenant admin or the API Credentials page in the Zuora UI.)"
    echo
    read -p "Configure Zuora credentials now? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        read -p "Environment name (e.g. intQA, sandbox, production): " ZDF_ENV_NAME
        ZDF_ENV_NAME="${ZDF_ENV_NAME:-intQA}"
        read -p "Zuora REST base URL (e.g. https://rest.test.zuora.com): " ZDF_BASE_URL
        read -p "OAuth client ID: " ZDF_CLIENT_ID
        read -s -p "OAuth client secret: " ZDF_CLIENT_SECRET
        echo

        if [ -n "$ZDF_ENV_NAME" ] && [ -n "$ZDF_BASE_URL" ] && [ -n "$ZDF_CLIENT_ID" ] && [ -n "$ZDF_CLIENT_SECRET" ]; then
            node /usr/local/share/cgeaa/zdf/dist/zdf.js auth add \
                --name "$ZDF_ENV_NAME" \
                --url "$ZDF_BASE_URL" \
                --client-id "$ZDF_CLIENT_ID" \
                --client-secret "$ZDF_CLIENT_SECRET" && \
            node /usr/local/share/cgeaa/zdf/dist/zdf.js auth use "$ZDF_ENV_NAME" && \
            log_success "Zuora environment '$ZDF_ENV_NAME' configured and set as active." || \
            log_warning "Zuora auth setup failed. Run manually: cgeaa zuora auth add --name <name> --url <url> --client-id <id> --client-secret <secret>"
        else
            log_warning "Incomplete credentials — skipping Zuora auth setup."
            echo "  Run later: cgeaa zuora auth add --name <name> --url <url> --client-id <id> --client-secret <secret>"
        fi
    else
        echo "Skipping Zuora auth setup."
        echo "  Run later: cgeaa zuora auth add --name <name> --url <url> --client-id <id> --client-secret <secret>"
        echo "  Then:      cgeaa zuora auth use <name>"
    fi
fi
